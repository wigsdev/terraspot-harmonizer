#!/usr/bin/env sh
commit_msg=$(cat "$1")
pattern="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_-]+\))?: .+$"

if ! echo "$commit_msg" | grep -Eq "$pattern"; then
  echo "❌ Error: Commit message does not adhere to Conventional Commits v1.0.0!"
  echo "Format: <type>(<scope>): <subject>"
  echo "Valid types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo "Example: feat(scaffolding): initialize Vite 8 and React 19 core (T-02)"
  exit 1
fi
